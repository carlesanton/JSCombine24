[Unit]
Description=Generative Landscapes Chrome Kiosk
After=generative-landscapes-container.service graphical.target graphical-session.target
Requires=generative-landscapes-container.service

[Service]
Type=simple
ExecStartPre=/bin/bash -c 'mv  /home/generativelandscapes/.config/google-chrome/chrome_debug.log /home/generativelandscapes/repos/JSCombine24/_logs/$(date +%%Y-%%m-%%d-%%H-%%M).log || true'
ExecStart=/bin/bash -c 'until xset q >/dev/null 2>&1; do sleep 0.5; done; exec /usr/bin/google-chrome --kiosk --disable-gpu-sandbox --enable-logging --v=1 http://127.0.0.1:8080/app/'
Restart=always
RestartSec=5
RuntimeMaxSec=25min
Environment=DISPLAY=:1

[Install]
WantedBy=default.target
