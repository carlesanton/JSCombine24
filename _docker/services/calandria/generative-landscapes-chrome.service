[Unit]
Description=Generative Landscapes Chrome Kiosk
After=generative-landscapes-container.service graphical.target
Requires=generative-landscapes-container.service

[Service]
Type=simple
ExecStart=/usr/bin/google-chrome --kiosk http://127.0.0.1:8080/app/
Restart=always
RestartSec=5
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/YOUR_USER/.Xauthority

[Install]
WantedBy=graphical.target
