[Unit]
Description=Generative Landscapes Docker Compose
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=
ExecStart=/usr/bin/docker-compose -f ./_docker/docker-compose.yml up
ExecStop=/usr/bin/docker-compose -f ./_docker/docker-compose.yml down
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
